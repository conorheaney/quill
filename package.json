{
  "name": "Quill",
  "version": "1.1.1",
  "description": "Local-first Markdown editor with a Tauri desktop shell.",
  "private": true,
  "scripts": {
    "test": "npm run test:node && npm run test:rust",
    "test:node": "node --test",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "start": "npm run tauri:dev",
    "build:frontend": "node scripts/build-frontend.ts",
    "typecheck": "tsc --noEmit",
    "smoke:dev": "npm run build:frontend && node scripts/serve-quill.ts",
    "check:workflow": "powershell -NoProfile -ExecutionPolicy Bypass -File .agents/lifecyle-agent/check-workflow.ps1",
    "check:workflow:details": "powershell -NoProfile -ExecutionPolicy Bypass -File .agents/lifecyle-agent/check-workflow.ps1 -Detailed",
    "tauri:info": "tauri info",
    "tauri:dev": "tauri dev",
    "version:bump": "node scripts/bump-version.ts",
    "build": "npm run tauri:build",
    "tauri:build": "tauri build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^26.4.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1"
  }
}
